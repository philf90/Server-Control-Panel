[Unit]
Description=SrvPanel — Speichermessung im Viertelstundentakt
Documentation=https://repo.cloudsrv24.de/

# Gehört zu `srvpanel.target`: Ein `stop` oder `restart` des Ziels nimmt
# diese Unit mit. Ohne diese Zeile wäre das Ziel ein Griff, der nur
# anschaltet — und das ist ein halber Griff.
PartOf=srvpanel.target

[Timer]
# Fünf Minuten nach dem Start und danach alle fünfzehn Minuten. Der Versatz
# nach dem Booten ist Absicht: In den ersten Minuten fährt der Server hoch,
# und eine Messung, die dabei auf einen noch nicht laufenden Agenten trifft,
# ist eine Fehlermeldung ohne Anlass.
OnBootSec=5min

# Dieselbe Behebung wie in `srvpanel-cron.timer` und aus demselben Grund: Ein
# Sockel, der an der letzten Aktivierung hängt, kann die Kette verlieren und
# dann `active` bleiben, ohne je wieder einen Termin zu haben. Hier ist es nie
# aufgefallen — was nichts über die Bauart sagt, sondern nur darüber, dass
# niemand hingesehen hat.
OnCalendar=*:0/15

# Ein Server, der über Nacht ausgeschaltet war, misst nach dem Einschalten
# einmal nach, statt bis zum nächsten Viertelstundenschlag mit Werten von
# gestern dazustehen.
Persistent=true

# 90 Sekunden Streuung. Auf einem einzelnen Server bedeutungslos, auf zwanzig
# gleichzeitig eingerichteten nicht: Sie messen sonst alle in derselben
# Sekunde.
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
