#!/bin/sh
# Der PHP-Aufruf des Panels — eine Stelle, an der steht, welcher Interpreter
# gemeint ist.
#
# Zielbild (§4.3 des Plans) ist eine mitgelieferte Fassung unter
# /opt/srvpanel/php. Solange die nicht gebaut ist, nimmt das Panel die
# Fassung, die die Installation ausgewählt und in /etc/srvpanel/php.path
# hinterlegt hat. Der Wechsel später ändert eine Datei und keine Unit.
set -eu

if [ -x /opt/srvpanel/php/bin/php ]; then
    exec /opt/srvpanel/php/bin/php "$@"
fi

if [ -r /etc/srvpanel/php.path ]; then
    # shellcheck disable=SC1091
    . /etc/srvpanel/php.path
fi

exec "${SRVPANEL_PHP:-/usr/bin/php}" "$@"
