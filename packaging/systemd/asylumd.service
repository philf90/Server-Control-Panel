# Diese Unit gehört zum .deb-Paket und verwendet deshalb die FHS-Pfade unter
# /usr/lib. Der curl-Installer schreibt sich eine eigene, inhaltsgleiche Unit
# mit /usr/local-Pfaden — beide Installationswege kommen sich nicht ins Gehege.

[Unit]
Description=Project Asylum — Control Panel
Documentation=https://github.com/philf90/Server-Control-Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/lib/asylum/asylumd serve --config /etc/asylum/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Das Panel verwaltet den Host, braucht also root. Die folgenden Einstellungen
# begrenzen den Schaden, ohne die Verwaltungsaufgaben zu blockieren.
# NoNewPrivileges bleibt aus: apt, useradd und passwd rufen setuid-Programme auf.
#
# ProtectHome=false statt read-only: Der Dateimanager (ab 0.3.0) bearbeitet
# Konfigurationsdateien unter /etc und Daten unter /home und /root. Mit
# ProtectHome=read-only scheiterte jeder Schreibversuch dort mit EROFS, und zwar
# ohne dass die Rechtebits der Verzeichnisse etwas davon verraten.
#
# ProtectSystem=no seit 0.6.1, und das ist eine Berichtigung. Bis dahin stand
# hier "true", also /usr read-only — mit der Begründung, dort habe ein Panel
# nichts von Hand zu ändern. Der Satz stimmt und übersieht das Entscheidende:
# Die Einschränkung gilt für den Dienst UND JEDEN SEINER KINDPROZESSE, und apt
# ist ein Kindprozess. Damit war jede Paketinstallation und jedes Paket-Update
# über das Panel unmöglich — dpkg brach beim Auspacken ab:
#
#   unable to create '/usr/sbin/nginx.dpkg-new'
#     (while processing './usr/sbin/nginx'): Read-only file system
#
# Ein Panel, dessen Aufgabe unter anderem das Einspielen von Paketen ist, kann
# /usr nicht schreibgeschützt halten. Was von der Zusage bleibt, steht eine
# Zeile tiefer: /boot und /efi rührt das Panel nie an, und dabei bleibt es.
#
# Wer den Dateimanager nicht braucht, kann ProtectHome wieder verschärfen und
# `files.enabled: false` setzen. ProtectSystem lässt sich NICHT verschärfen,
# ohne die Paketverwaltung mit abzuschalten.
NoNewPrivileges=no
ProtectSystem=no
ReadOnlyPaths=-/boot -/efi
ProtectHome=false
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Selbstverpflichtung: Das Panel darf nicht unbemerkt fett werden. Gemessen
# liegt es bei rund 20 MB RSS im Leerlauf, und dabei soll es bleiben — wird das
# von ihm selbst erreicht, ist das ein Bug und kein Anlass zum Hochsetzen.
#
# Die Zahl steht seit 0.6.1 trotzdem auf 768M, aus demselben Grund wie
# ProtectSystem eine Zeile weiter oben: Das Limit gilt für die Kontrollgruppe
# der Unit, und apt und dpkg laufen darin. 256M reichen dem Panel, aber ein
# `apt-get upgrade` über zweihundert Pakete kann sie allein aufbrauchen. Ein
# OOM-Kill mitten in einer dpkg-Transaktion ist der schlechteste Ausgang von
# allen: Er hinterlässt ein halb ausgepacktes Paket.
MemoryMax=768M
TasksMax=256

# Die eigenen Verzeichnisse ausdrücklich, auch wenn ProtectSystem=true sie schon
# zulässt: Wer die Härtung später wieder verschärft, soll den Dienst nicht
# nebenbei lahmlegen.
ReadWritePaths=/etc/asylum /var/lib/asylum /var/log/asylum

StandardOutput=journal
StandardError=journal
SyslogIdentifier=asylumd

[Install]
WantedBy=multi-user.target
