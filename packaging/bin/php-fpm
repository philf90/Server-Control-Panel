#!/bin/sh
# Siehe /opt/cloudsrv/bin/php — dieselbe Auswahl, anderes Programm.
set -eu

if [ -x /opt/cloudsrv/php/sbin/php-fpm ]; then
    exec /opt/cloudsrv/php/sbin/php-fpm "$@"
fi

if [ -r /etc/cloudsrv/php.path ]; then
    # shellcheck disable=SC1091
    . /etc/cloudsrv/php.path
fi

exec "${CLOUDSRV_PHP_FPM:-/usr/sbin/php-fpm}" "$@"
