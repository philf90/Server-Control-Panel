# Diese Unit gehört zum .deb-Paket und verwendet deshalb die FHS-Pfade unter
# /usr/lib. Der curl-Installer schreibt sich eine eigene, inhaltsgleiche Unit
# mit /usr/local-Pfaden — beide Installationswege kommen sich nicht ins Gehege.

[Unit]
Description=Project Asylum — Control Panel
Documentation=https://github.com/philf90/Server-Control-Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/lib/asylum/asylumd serve --config /etc/asylum/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Das Panel verwaltet den Host, braucht also root. Die folgenden Einstellungen
# begrenzen den Schaden, ohne die Verwaltungsaufgaben zu blockieren.
# NoNewPrivileges bleibt aus: apt, useradd und passwd rufen setuid-Programme auf.
#
# ProtectSystem=true statt full, ProtectHome=false statt read-only: Der
# Dateimanager (ab 0.3.0) bearbeitet Konfigurationsdateien unter /etc und Daten
# unter /home und /root. Mit "full" wäre /etc nur lesbar, mit
# ProtectHome=read-only auch /home — jeder Schreibversuch dort scheiterte mit
# EROFS, und zwar ohne dass die Rechtebits der Verzeichnisse etwas davon
# verraten. /usr, /boot und /efi bleiben über "true" schreibgeschützt: Dort hat
# ein Panel nichts von Hand zu ändern, und der Schutz gegen ein untergeschobenes
# Binary bleibt damit erhalten.
#
# Wer den Dateimanager nicht braucht, kann beides wieder verschärfen und
# `files.enabled: false` setzen.
NoNewPrivileges=no
ProtectSystem=true
ProtectHome=false
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Selbstverpflichtung: Das Panel darf nicht unbemerkt fett werden.
# Wird das Limit erreicht, ist das ein Bug, kein Anlass zum Hochsetzen.
MemoryMax=256M
TasksMax=256

# Die eigenen Verzeichnisse ausdrücklich, auch wenn ProtectSystem=true sie schon
# zulässt: Wer die Härtung später wieder verschärft, soll den Dienst nicht
# nebenbei lahmlegen.
ReadWritePaths=/etc/asylum /var/lib/asylum /var/log/asylum

StandardOutput=journal
StandardError=journal
SyslogIdentifier=asylumd

[Install]
WantedBy=multi-user.target
