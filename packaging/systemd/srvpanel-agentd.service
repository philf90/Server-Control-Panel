[Unit]
Description=SrvPanel — privilegierter Agent
Documentation=https://repo.cloudsrv24.de/
After=network.target
Before=srvpanel-worker.service srvpanel-metrics.service

# Gehört zu `srvpanel.target`: Ein `stop` oder `restart` des Ziels nimmt
# diese Unit mit. Ohne diese Zeile wäre das Ziel ein Griff, der nur
# anschaltet — und das ist ein halber Griff.
PartOf=srvpanel.target

[Service]
Type=simple
# `pcre.jit=0`, und zwar wegen MemoryDenyWriteExecute weiter unten.
#
# Der JIT von PCRE will Speicher, der beschreibbar und ausführbar zugleich
# ist — genau das, was die Härtung verbietet. PHP kommt damit zurecht und
# schaltet den JIT ab, schreibt dabei aber bei jedem Start eine Warnung ins
# Journal. Bei einem Prozess, der je Verbindung forkt, sind das vier Zeilen
# pro Aufruf des Panels.
#
# Die Alternative wäre, die Härtung zu lockern. Für einen Dienst, der als
# root Systembenutzer anlegt und Pakete installiert, ist der PCRE-JIT das
# schlechtere Tauschgut: Er beschleunigt reguläre Ausdrücke, die hier
# ausschließlich kurze Unit-Namen und Pfade prüfen.
ExecStart=/opt/srvpanel/bin/php -d pcre.jit=0 /opt/srvpanel/current/agent/bin/srvpanel-agentd serve --config=/etc/srvpanel/agent.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# Der Agent legt Systembenutzer an, lädt nginx neu und installiert Pakete. Er
# braucht root, und die Härtung kann deshalb nur begrenzen, was er sonst noch
# könnte — nicht, was seine Aufgabe ist.
#
# Was hier NICHT steht, ist so wichtig wie das, was steht:
#   ProtectSystem=  bleibt aus. Beim Vorgänger stand hier „true", also /usr
#                   read-only. Jede Paketinstallation brach daraufhin beim
#                   Auspacken ab, weil die Einschränkung für jeden Kindprozess
#                   gilt und dpkg einer ist. Gefunden hat das kein Test,
#                   sondern der erste Lauf auf einem echten Server.
#   ProtectHome=    bleibt aus. Die Abo-Verzeichnisse liegen unter
#                   /var/www/vhosts, der Dateimanager arbeitet dort.
#   NoNewPrivileges bleibt aus. useradd und apt rufen setuid-Programme auf.
ReadOnlyPaths=-/boot -/efi
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# **Nur `RuntimeDirectory`, und das ist ein Befund** (`docs/67`, Befund 1).
#
# Hier standen zusätzlich `LogsDirectory=srvpanel` und
# `StateDirectory=srvpanel`. Beide sagen systemd: „dieses Verzeichnis gehört
# diesem Dienst" — und systemd zieht dann bei **jedem Start** den Modus auf
# `StateDirectoryMode` nach, dessen Vorgabe `0755` ist. Dieser Dienst läuft als
# root; `/var/lib/srvpanel` gehört aber dem Panel und ist als
# `0750 srvpanel:srvpanel` ausgeliefert.
#
# Gemessen auf `cloudsrv24` am 21. August 2026: vor `systemctl restart
# srvpanel-agentd` stand es auf `750`, danach auf `755`. Fünf Stellen im
# Projekt behaupteten `0750` — `nfpm.yaml`, `postinstall.sh`, `testbed.sh` und
# `PackagingTest` —, und diese eine Zeile hob es jedes Mal wieder auf.
#
# > **Ein Verzeichnis, dessen Rechte an zwei Stellen festgelegt werden, hat die
# > Rechte der Stelle, die zuletzt läuft.**
#
# Der Agent braucht die beiden Angaben nicht: Er liest weder `$STATE_DIRECTORY`
# noch `$LOGS_DIRECTORY`, sondern trägt seine Pfade absolut
# (`Config::$logFile`, `Dump::ROOT`, `Staging::ROOT`), und `postinstall.sh`
# legt beide Verzeichnisse mit dem gewollten Eigentümer an.
#
# `RuntimeDirectory` bleibt, weil es das Gegenteil ist: `/run` ist ein tmpfs
# und nach jedem Neustart leer, den Socket legt niemand sonst an, und `0755`
# steht hier ausdrücklich daneben statt als Vorgabe.
# **`Preserve=yes`, und das ist Befund 4 aus `docs/67`.**
#
# In `/run/srvpanel` liegt nicht nur `agent.sock`, sondern auch der Socket und
# die PID-Datei von PHP-FPM (`packaging/etc/fpm.conf`) — nginx spricht über
# `fastcgi_pass unix:/run/srvpanel/fpm.sock`. Das Verzeichnis ist aber nur
# **hier** als `RuntimeDirectory` angemeldet, und systemds Vorgabe
# `RuntimeDirectoryPreserve=no` löscht es beim **Stoppen** dieser Unit mitsamt
# Inhalt.
#
# Ein `systemctl restart srvpanel-agentd` nahm damit `fpm.sock` mit. PHP-FPM
# läuft weiter und legt seinen Socket nicht neu an — nginx findet nichts mehr
# und antwortet mit **502**, während beide Dienste `active` melden. Gemessen
# auf `cloudsrv24` am 21. August 2026, ausgelöst durch die Gegenprobe zu
# Befund 1.
#
# > **Ein Verzeichnis, das einem Dienst gehört, nimmt beim Neustart mit, was
# > ein anderer hineingelegt hat.**
#
# **Warum das gefahrlos ist.** `/run` ist ein tmpfs: Der Inhalt überlebt keinen
# Rechnerneustart, und genau darauf beruht die Begründung von
# {@see \SrvPanel\Agent\Db\Credentials::DIRECTORY} — ein Passwort, das nach
# einem Absturz auf der Platte liegt, ist ein Passwort auf der Platte. Diese
# Zusage bleibt; erhalten bleibt das Verzeichnis nur über den Neustart eines
# Dienstes hinweg.
#
# Und ein liegengebliebener `agent.sock` hält den Agenten nicht auf:
# `Daemon::listen()` entfernt ihn vor dem Binden und legt das Verzeichnis
# notfalls selbst an.
RuntimeDirectory=srvpanel
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
