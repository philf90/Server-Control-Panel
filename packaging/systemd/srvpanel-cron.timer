[Unit]
Description=SrvPanel — die Läufe der Cronjobs einsammeln
Documentation=https://repo.cloudsrv24.de/

[Timer]
# Zwei Minuten nach dem Start und danach alle fünf Minuten. Der Versatz nach dem
# Booten ist derselbe Gedanke wie bei srvpanel-usage.timer: In den ersten
# Minuten fährt der Server hoch, und ein Einsammeln, das auf einen noch nicht
# laufenden Agenten trifft, ist eine Fehlermeldung ohne Anlass.
#
# **Fünf Minuten und nicht fünfzehn.** Der Agent bringt je Aufruf höchstens 500
# Läufe mit; ein Kunde mit zehn Minutenjobs erzeugt 50 in fünf Minuten und 150
# in fünfzehn. Der Abstand ist an der Deckelung gewählt und nicht am Gefühl —
# und was trotzdem liegen bleibt, meldet das Kommando als „wartet noch".
OnBootSec=2min

# **Wall-clock und nicht monoton, und das ist eine Behebung vom 19. August
# 2026.** Vorher stand hier allein `OnUnitActiveSec=5min`. Dieser Sockel hängt
# an der letzten Aktivierung des Dienstes: Reisst die Kette einmal — ein
# `daemon-reload` beim Paketwechsel, ein Neustart der Unit —, kann der Timer
# `active` bleiben, ohne je wieder einen Termin zu haben. Auf `cloudsrv24`
# gemessen: `systemctl is-active` sagte `active`, `NEXT` stand auf `-`, und der
# letzte Lauf lag **22 Stunden** zurück. In der Zwischenzeit sammelte niemand
# die Läufe ein, und niemand hat es gemeldet.
#
#   Ein Dienst, der „active" meldet und keinen nächsten Termin hat, ist
#   abgeschaltet und sieht aus wie eingeschaltet.
#
# `OnCalendar` rechnet gegen die Uhr und braucht keine Vorgeschichte. Erst damit
# bedeutet `Persistent=true` unten überhaupt etwas — für einen rein monotonen
# Timer ist es wirkungslos.
OnCalendar=*:0/5

# Ein Server, der über Nacht aus war, sammelt nach dem Einschalten einmal nach,
# statt bis zum nächsten Fünfminutenschlag zu warten.
Persistent=true

# 30 Sekunden Streuung. Auf einem einzelnen Server bedeutungslos, auf zwanzig
# gleichzeitig eingerichteten nicht.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
