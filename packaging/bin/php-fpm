#!/bin/sh
# Siehe /opt/srvpanel/bin/php — dieselbe Auswahl, anderes Programm.
set -eu

if [ -x /opt/srvpanel/php/sbin/php-fpm ]; then
    exec /opt/srvpanel/php/sbin/php-fpm "$@"
fi

if [ -r /etc/srvpanel/php.path ]; then
    # shellcheck disable=SC1091
    . /etc/srvpanel/php.path
fi

exec "${SRVPANEL_PHP_FPM:-/usr/sbin/php-fpm}" "$@"
