#!/bin/sh
# Die Kommandozeile des Panels.
#
# Sie ruft artisan im Verzeichnis der aktiven Fassung auf — als Benutzer
# srvpanel, damit ein Lauf von Hand keine Dateien hinterlässt, die der Dienst
# danach nicht mehr schreiben kann.
#
# Die eigenen Kommandos liegen in artisan unter dem Namensraum "srvpanel:";
# hier vorne darf man sie ohne schreiben. So heißt es "srvpanel setup" und
# nicht "srvpanel srvpanel:setup", ohne dass in artisan unbenannte Kommandos
# neben denen des Frameworks stehen.
#
# **Diese Liste muss vollständig sein.** `admin` fehlte, und das fiel lange
# nicht auf, weil niemand ein Konto über die Kommandozeile anlegte: Wer
# `srvpanel admin` tippte, bekam „Command not defined" — für ein frisch
# eingerichtetes Panel ist das der Unterschied zwischen benutzbar und nicht.
# Dass jedes `srvpanel:`-Kommando hier steht, prüft
# tests/Feature/PackagingTest.php; abgeleitet wird die Liste nicht, denn das
# hiesse, für jeden Aufruf erst PHP zu starten.
set -eu

COMMAND="${1:-list}"

# "srvpanel --version" fragt nach dem Panel, nicht nach Laravel.
#
# Ohne diese Zeile reicht der Wrapper den Schalter durch, und artisan nennt die
# Fassung des Frameworks: Am 10. August 2026 stand auf cloudsrv24 „Laravel
# Framework 13.23.0" — richtig, und für die Frage „ist rc.2 installiert?"
# wertlos. Wer den Schalter tippt, meint das Programm, das er aufruft.
case "${COMMAND}" in
    --version)
        COMMAND="version"
        ;;
esac

case "${COMMAND}" in
    setup|update|metrics|usage|cron-runs|tls|dns|db|vhost|acceptance|acceptance-web|acceptance-db|admin|version)
        shift
        set -- "srvpanel:${COMMAND}" "$@"
        ;;
esac

if [ "$(id -u)" = "0" ]; then
    exec setpriv --reuid=srvpanel --regid=srvpanel --init-groups \
        /opt/srvpanel/bin/php /opt/srvpanel/current/artisan "$@"
fi

exec /opt/srvpanel/bin/php /opt/srvpanel/current/artisan "$@"
