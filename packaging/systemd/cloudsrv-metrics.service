[Unit]
Description=CloudSrv — Kennzahlen im Zehnsekundentakt
Documentation=https://repo.cloudsrv24.de/
After=cloudsrv-agentd.service
Requires=cloudsrv-agentd.service

[Service]
Type=simple
User=cloudsrv
Group=cloudsrv
WorkingDirectory=/opt/cloudsrv/current
ExecStart=/opt/cloudsrv/bin/php artisan cloudsrv:kennzahlen
Restart=always
RestartSec=5s

# Dieser Dienst liest /proc über den Agenten und schreibt Ringpuffer. Mehr
# braucht er nicht — und mehr bekommt er nicht.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/cloudsrv /var/log/cloudsrv

MemoryMax=192M
TasksMax=32

[Install]
WantedBy=multi-user.target
