#!/bin/sh
# Die Kommandozeile des Panels.
#
# Sie ruft artisan im Verzeichnis der aktiven Fassung auf — als Benutzer
# srvpanel, damit ein Lauf von Hand keine Dateien hinterlässt, die der Dienst
# danach nicht mehr schreiben kann.
#
# Die eigenen Kommandos liegen in artisan unter dem Namensraum "srvpanel:";
# hier vorne darf man sie ohne schreiben. So heißt es "srvpanel setup" und
# nicht "srvpanel srvpanel:setup", ohne dass in artisan unbenannte Kommandos
# neben denen des Frameworks stehen.
set -eu

COMMAND="${1:-list}"

case "${COMMAND}" in
    setup|update|metrics)
        shift
        set -- "srvpanel:${COMMAND}" "$@"
        ;;
esac

if [ "$(id -u)" = "0" ]; then
    exec setpriv --reuid=srvpanel --regid=srvpanel --init-groups \
        /opt/srvpanel/bin/php /opt/srvpanel/current/artisan "$@"
fi

exec /opt/srvpanel/bin/php /opt/srvpanel/current/artisan "$@"
