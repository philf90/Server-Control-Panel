#!/bin/sh
#
# apt-run — spielt Aktualisierungen ein und sagt am Ende, ob es etwas bewirkt hat.
#
# Aufgerufen wird es ausschliesslich aus einer transienten systemd-Unit, die
# `system.packages.upgrade` absetzt:
#
#     systemd-run --unit=srvpanel-update-<hex> --collect \
#         --property=StandardOutput=append:/var/log/srvpanel/upgrade.log \
#         /usr/lib/srvpanel/apt-run all
#     /usr/lib/srvpanel/apt-run packages tar gzip
#
# ## Und seit dem 26. August auch aus `system.packages.list`
#
# Der Modus `simulate` sieht nur nach. Er steht hier und nicht im Agenten, weil
# apt **an zwei Orten zwei verschiedene Antworten gibt** — und der Ort, der
# zählt, ist der, an dem eingespielt wird.
#
# `srvpanel-agentd.service` läuft mit `PrivateTmp`, `ProtectKernelTunables` und
# `ProtectControlGroups`; jede davon legt einen Mount-Namensraum an, und darin
# meldet `ischroot` **rc=0**. In einem chroot wendet Ubuntu sein *Phasing* nicht
# an, hält also nichts zurück und bietet alles an. Gemessen auf `cloudsrv24` am
# 26. August 2026 (`docs/86`, Befund 6):
#
#     im Agenten          -> 11 `Inst`-Zeilen
#     transiente Unit     ->  4
#     RestrictNamespaces  ->  4   (legt keinen Namensraum an)
#
# Die Seite zeigte elf, und `apt-run all` spielte vier ein. Beides war für sich
# richtig; zusammen war es eine Lüge.
#
# > **Zwei Läufe desselben Befehls an zwei Orten sind zwei Messungen und nicht
# > eine.**
#
# Eine Option war der falsche Ausweg: `APT::Get::Always-Include-Phased-Updates`
# greift gegen die Chroot-Erkennung nicht (gemessen), und
# `Never-Include-Phased-Updates` greift zwar, hält phasenverzögerte Pakete aber
# **immer** zurück — auch auf einer Maschine, die Ubuntu für die Phase
# ausgewählt hat. Sie brächte die beiden Seiten zur Übereinstimmung, indem sie
# beide verschiebt.
#
# ## Warum ein Skript und kein `sh -c` im Agenten
#
# Weil hier mehr als eine Zeile steht. `panel.update` setzt seinen Lauf seit P0
# als `sh -c 'apt-get update -qq && apt-get install …'` ab, und das ist für eine
# Zeile richtig. Sobald ein Vorher/Nachher dazukommt, wäre es eine
# Zeichenkette in PHP, die keine Prüfung sieht — shellcheck fährt über dieses
# Verzeichnis, über eine Zeichenkette in PHP fährt nichts.
#
# ## Warum es überhaupt zählt
#
# `docs/81 §2.1a`, M5, vierte Zeile — und gemessen am 26. August 2026:
#
#     apt-get install -y --only-upgrade dpkg   (bereits aktuell)
#     -> "0 upgraded, 0 newly installed, 0 to remove and 144 not upgraded."
#     -> rc=0
#
# > **Ein Lauf, der nichts bewirkt hat, endet mit 0 und sieht aus wie Erfolg.**
#
# Deshalb zählt dieses Skript vorher und nachher, wie viele Aktualisierungen
# offen sind, und macht daraus die letzte Zeile des Protokolls. Bleibt die Zahl
# gleich, endet es **ungleich 0** — die Unit steht dann auf `failed`, und
# `systemctl status` sagt dasselbe wie das Protokoll.
#
# ## Die vier Optionen und je ein Satz dazu
#
# `-q`            — ohne den Fortschrittsbalken, der sonst hunderte `\r` schreibt.
# `-y`            — niemand sitzt davor.
# `Dpkg::Use-Pty=0` — gemessen: die längste Zeile fällt von 1400 auf 103 Zeichen.
#                   Ohne sie steht der Datenbankfortschritt von dpkg als eine
#                   einzige Zeile im Protokoll, zwanzigmal „(Reading database …".
# `--force-confold` — Frage 3 aus `docs/81 §3`, entschieden durch M12: Ohne eine
#                   `--force-conf*`-Fahne stellt dpkg seine Frage auf stdin, und
#                   `DEBIAN_FRONTEND=noninteractive` beantwortet sie **nicht**.
#                   Der Lauf wartet dann ohne Frist oder bricht mit rc=1 ab, und
#                   das Paket bleibt `iU` — halb installiert.
#
set -u

NAME=apt-run

# Die Trennzeile zwischen den beiden Simulationen von `simulate`.
#
# **Ein Lauf und nicht zwei**, weil jede transiente Unit einen Prozess kostet
# und die Seite bei jedem Aufbau nachsieht. Die Marke steht am Zeilenanfang und
# trägt zwei Doppelpunkte — apt schreibt keine solche Zeile, und der Leser im
# Agenten besteht darauf, sie genau zweimal zu finden, statt zu raten.
MARKE='### srvpanel apt-run::'

fehler() {
    # **`Aufruf falsch — ` steht davor, damit der Leser es als Fehlschlag
    # erkennt.** Diese Zeile geht auf stderr, und stderr landet im selben Log:
    # Ohne einen Anfang, den `Outcome::BAD` kennt, gälte ein falscher Aufruf
    # als Erfolg mit einer Meldung.
    echo "$NAME: Aufruf falsch — $1" >&2
    exit 2
}

# Wie viele Aktualisierungen apt gerade sieht.
#
# **`-s` und nicht der Zähler von `apt list --upgradable`:** Es ist derselbe
# Lauf, den `system.packages.list` liest, also dieselbe Zahl, die auf der Seite
# steht. Zwei Wege zu einer Zahl gehen auseinander, und der zweite veraltet.
#
# **Und sie ist nicht dieselbe wie apts „not upgraded" eine Zeile darüber.**
# Gemessen: Nach `apt-get install dpkg` stand dort `142 not upgraded`, hier 140.
# Beide stimmen und beantworten verschiedene Fragen — apt zählt, was dieser
# Aufruf nicht angefasst hat, dieses Skript, was ein `dist-upgrade` noch täte.
# Die Differenz sind die zurückgehaltenen Pakete.
offen() {
    apt-get -s dist-upgrade 2>/dev/null | grep -c '^Inst ' || true
}

# Die installierte Fassung des Panels.
#
# **Das ist Teil 3 von M5** (`docs/81 §2.1b`): `panel.update` hat bis zum
# 26. August 2026 `apt-get update -qq && apt-get install --only-upgrade srvpanel`
# abgesetzt — und das `&&` griff nie, weil `apt-get update` immer 0 ist. Mit
# veralteten Listen fand `--only-upgrade` nichts Neueres, meldete „0 upgraded"
# und endete mit 0: Das Panel meldete „Update läuft", die Fassung blieb stehen,
# und im Protokoll stand ein erfolgreicher Lauf.
#
# > **Wenn die Fassung danach dieselbe ist, ist es gleichgültig, warum.**
#
# Diese eine Frage ersetzt jede Prüfung am Rückgabewert von `apt-get update`:
# Sie fällt gleich aus, ob eine Quelle tot war, ob die Listen alt waren oder ob
# es schlicht nichts Neues gibt.
fassung() {
    dpkg-query -W -f='${Version}' srvpanel 2>/dev/null || echo unbekannt
}

# Das Mass dieses Laufs — eine der beiden Funktionen darüber.
#
# **Ein `if` und kein `$mass` als Befehl.** Bis zum 1. September 2026 stand an
# den beiden Messstellen `$($mass)`, und ein Funktionsname in einer Variablen
# ist für ein Werkzeug kein Aufruf: shellcheck hielt die Rümpfe von `offen`
# und `fassung` für unerreichbar (SC2317). Gemeldet hat es das erst, als
# dieses Skript am Ende ausdrücklich mit `exit` endete — solange es
# durchfallen konnte, nahm shellcheck an, jemand binde die Datei ein und rufe
# sie selbst.
#
# > **Ein Aufruf über einen Namen in einer Variablen ist für ein Werkzeug
# > keiner — gemeldet wird er erst, wenn nichts mehr die Annahme trägt, dass
# > jemand ihn von aussen macht.**
#
# `$mass` bleibt, was es an den beiden Vergleichen weiter unten ohnehin schon
# war: ein Schalter und kein Befehl.
messen() {
    if [ "$mass" = fassung ]; then
        fassung
    else
        offen
    fi
}

# Wie viele Pakete dieser Lauf einspielen würde — vor dem Lauf gefragt.
#
# **Das ist Befund 2 aus `docs/94 §4`.** Die Unterscheidung „war schon aktuell"
# gegen „hat es nicht geschafft" entsteht im Lauf und wurde weggeworfen: Der
# Zählmodus konnte sie an `nachher -eq 0` ablesen, `--fassung` nicht, denn eine
# Versionsnummer ist nie null.
#
# > **Eine Unterscheidung, die im Lauf schon dasteht, muss nicht hergestellt
# > werden — nur gelesen.**
#
# **Gefragt wird apt in der Simulation und nicht sein Klartext.** Die
# naheliegende Quelle wäre der Satz, der im Protokoll drei Zeilen über dem
# Urteil steht — „srvpanel ist schon die neueste Version (0.7.3~rc.4)." Er ist
# **übersetzt**. Gemessen am 1. September 2026 gegen den deutschen Katalog von
# apt 2.8.3: `Inst ` kommt in keinem seiner 387 Einträge vor, „is already the
# newest version" schon, und der Zähler ist in beiden Sprachen derselbe (6 für
# ein anstehendes Paket, 0 für ein aktuelles).
#
# > **Ein Satz, den apt übersetzt, ist keine Schnittstelle** — ein Ausdruck
# > darüber prüft die Sprache des Servers und nicht seinen Zustand.
#
# **Mit denselben Argumenten wie der echte Lauf.** Eine Simulation, die etwas
# anderes fragt als das, was gleich ausgeführt wird, beantwortet eine andere
# Frage — derselbe Grund, aus dem `offen()` genau den `dist-upgrade` fragt, den
# auch die Seite zeigt.
ansteht() {
    apt-get -s "$@" 2>/dev/null | grep -c '^Inst ' || true
}

[ $# -ge 1 ] || fehler 'Aufruf: apt-run all | apt-run packages <name> ... | apt-run panel | apt-run simulate'

modus=$1
shift

case $modus in
    all)
        # Die Namen spielen hier keine Rolle; die Seite zeigt die Zahl aus
        # demselben `dist-upgrade`, und der Knopf tut, was dort steht — samt
        # dem, was daneben als „würde entfernt" ausgewiesen ist.
        mass=offen
        einheit='offene Aktualisierungen'
        set -- dist-upgrade
        ;;
    packages)
        [ $# -ge 1 ] || fehler 'apt-run packages braucht mindestens einen Namen.'

        # **Kein `--only-upgrade`.** Gemessen am 26. August 2026: Auf ein Paket,
        # das noch gar nicht installiert ist, tut es wortlos nichts und endet
        # mit 0. In der Liste stehen aber auch Neuinstallationen — eine Zeile
        # ohne alte Fassung —, und die fielen damit still unter den Tisch.
        mass=offen
        einheit='offene Aktualisierungen'
        set -- install "$@"
        ;;
    panel)
        # **Hier wurde bis zum 1. September 2026 aufgefrischt, und das ist mit
        # Befund 2 (`docs/94 §4`) nach `PanelUpdate` gezogen.**
        #
        # Der Grund ist nicht der Ort, sondern das Urteil darüber: Dieses Skript
        # konnte den Rückgabewert von `apt-get update` nicht prüfen (M5 — er
        # trägt nichts) und die `W:`-Zeilen ebensowenig. Gemessen am 1.
        # September gegen apt 2.8.3: Eine tote Quelle erzeugt **drei** davon,
        # und eine der drei („Download is performed unsandboxed…") hat mit
        # Quellen gar nichts zu tun. Ein Zähler darüber meldet mal richtig, mal
        # zuviel.
        #
        # `Apt::readFailures()` liest sie richtig, seit A1 und mit drei
        # ausgeschriebenen Fallen im Kopf. Ein zweiter Leser hier wäre eine
        # zweite Fassung derselben Regel.
        #
        # > **Eine Auskunft, die anderswo schon richtig gelesen wird, holt man
        # > sich von dort — auch wenn der Aufruf daneben stünde.**
        #
        # Für dieses Skript heisst das: Wenn `panel` läuft, sind die Listen
        # frisch und ihre Frische ist geprüft. Erst damit darf `ansteht` weiter
        # unten „es stand nichts an" bedeuten und nicht „apt weiss es nicht".
        mass=fassung
        einheit='Fassung'
        set -- install --only-upgrade srvpanel
        ;;
    simulate)
        # **Dieser Modus steigt hier aus und nicht unten.** Der gemeinsame Rumpf
        # misst ein Vorher, spielt ein und misst ein Nachher; hier gibt es
        # nichts einzuspielen und deshalb auch kein Vorher.
        #
        # Beide Läufe, weil sie verschiedene Fragen beantworten: `dist-upgrade`
        # sagt, was möglich ist, `upgrade` sagt, was ohne Entfernen möglich ist
        # — und nur der zweite nennt, was zurückgehalten wird.
        echo "$MARKE dist-upgrade"
        apt-get -s dist-upgrade
        erst=$?

        echo "$MARKE upgrade"
        apt-get -s upgrade
        zweit=$?

        # **Der erste Fehlschlag gewinnt, und keiner wird verschluckt.** Ein
        # `W:` auf stderr ist keiner — apt endet dabei mit 0, und genau darum
        # geht es in M5.
        [ "$erst" -eq 0 ] || exit "$erst"
        exit "$zweit"
        ;;
    *)
        fehler "Unbekannter Modus: $modus"
        ;;
esac

vorher=$(messen)
anstand=$(ansteht "$@")

apt-get -q -y -o Dpkg::Use-Pty=0 -o Dpkg::Options::=--force-confold "$@"
rueckgabe=$?

nachher=$(messen)

if [ "$rueckgabe" -ne 0 ]; then
    echo "$NAME: apt-get endete mit $rueckgabe. $einheit: vorher $vorher, jetzt $nachher."
    exit "$rueckgabe"
fi

# **Nichts zu tun ist kein Fehlschlag, und das ist eine Berichtigung vom
# 31. August 2026.**
#
# Bis dahin stand hier nur der Block darunter, und er traf auch den Fall, in dem
# gar nichts anstand: `vorher` und `nachher` beide null. Auf `cloudsrv24`
# gemessen (`docs/91 §17`) — der zweite Lauf desselben Knopfes meldete
# `fehlgeschlagen`, mit dem Satz „offene Aktualisierungen vorher wie nachher: 0".
#
#   Ein Urteil, das seine Zahl mitbringt und nur an seinem Anfang gelesen wird,
#   wirft die Unterscheidung weg, die es trägt.
#
# Und eine Ebene tiefer ist es die Spiegelung von M5, dem Befund, mit dem P7b
# angefangen hat:
#
#   Ein Rückgabewert, der „nichts zu tun" und „nicht geschafft" gleich benennt,
#   ist derselbe Fehler wie einer, der einen Fehlschlag nicht tragen kann — nur
#   in die andere Richtung.
#
# Warum es zählt: Ein Server mit eingeschalteter Automatik hat den Fall
# regelmässig. Nach der dritten Woche mit roten Vorgängen, die nichts bedeuten,
# sieht niemand mehr einen roten Vorgang an.
#
# **In allen drei Modi, und das ist Befund 2 aus `docs/94 §4`.** Bis zum
# 1. September 2026 stand hier `[ "$mass" = offen ] && … && [ "$nachher" -eq 0 ]`,
# und diese Beschränkung war selbst der Fehler: Sie liest die Frage „stand etwas
# an?" an einem Wert ab, der sie nur für `all` beantwortet. Bei `packages`
# bleiben andere Aktualisierungen offen, bei `panel` ist `nachher` eine
# Versionsnummer — beide Male sah „war schon aktuell" aus wie „hat es nicht
# geschafft".
#
# > **Ein Wert, der eine Frage nur in einem Modus beantwortet, ist in den
# > anderen keine Antwort, sondern ein Zufall.**
#
# Gefragt wird jetzt `ansteht`, und die Bedingung nennt den Modus nicht
# mehr. Beide Hälften sind nötig: `anstand` sagt, dass nichts anstand, und
# `vorher = nachher`, dass auch nichts geschehen ist — hätte ein Lauf ohne
# Anlass doch etwas verändert, gehört das gemeldet und nicht beschwiegen.
if [ "$anstand" -eq 0 ] && [ "$vorher" = "$nachher" ]; then
    echo "$NAME: Es stand nichts an — $einheit unverändert: $nachher."
    exit 0
fi

if [ "$vorher" = "$nachher" ]; then
    # **Der Fall, für den es dieses Skript gibt.** Er tritt ein, wenn die
    # Paketlisten veraltet sind (M5), wenn eine Quelle abgeschaltet ist, oder
    # wenn ein Name zwar bekannt, aber schon aktuell war.
    #
    # Der vierte Fall — es stand gar nichts an — steht darüber und ist keiner
    # von diesen: Dort sollte nichts geschehen, hier sollte etwas geschehen und
    # ist ausgeblieben.
    echo "$NAME: Der Lauf hat nichts verändert — $einheit vorher wie nachher: $nachher."
    exit 3
fi

# **Beide Zweige enden ausdrücklich**, obwohl das Skript hier ohnehin aufhört.
# Damit gilt ohne Ausnahme: Auf eine Zeile mit `$NAME:` folgt ein `exit` — und
# genau das hält `OutcomeTest`.
if [ "$mass" = fassung ]; then
    echo "$NAME: Fassung $vorher wurde zu $nachher."
    exit 0
fi

echo "$NAME: $((vorher - nachher)) von $vorher Aktualisierungen eingespielt, $nachher bleiben offen."
exit 0
