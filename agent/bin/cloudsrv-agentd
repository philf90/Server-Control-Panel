#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * cloudsrv-agentd — der einzige Prozess des Panels mit Systemrechten.
 *
 * Aufrufe:
 *   cloudsrv-agentd serve [--config=DATEI] [--socket=PFAD] [--unprivileged]
 *   cloudsrv-agentd call OP [JSON-ARGUMENTE] [--socket=PFAD]
 *   cloudsrv-agentd ops
 *
 * `call` ist kein Verwaltungsweg, sondern das Werkzeug für die
 * Bereitschaftsprüfung nach einem Update und für den Rauchtest der CI. Es
 * spricht über denselben Socket und dieselbe Prüfung wie die Anwendung — eine
 * Abkürzung am Protokoll vorbei gibt es nicht.
 */

namespace CloudSrv\Agent;

require __DIR__ . '/../src/autoload.php';

$args = $argv;
array_shift($args);
$command = $args[0] ?? 'serve';
$options = [];
$positional = [];

foreach (array_slice($args, 1) as $chunk) {
    if (str_starts_with($chunk, '--')) {
        $pair = explode('=', substr($chunk, 2), 2);
        $options[$pair[0]] = $pair[1] ?? true;
    } else {
        $positional[] = $chunk;
    }
}

$configFile = is_string($options['config'] ?? null) ? $options['config'] : '/etc/cloudsrv/agent.json';
$config = Config::fromFile($configFile);

$overrides = [];
if (is_string($options['socket'] ?? null)) {
    $overrides['socket'] = $options['socket'];
}
if (is_string($options['log'] ?? null)) {
    $overrides['protocol'] = $options['log'];
}
if (is_string($options['user'] ?? null)) {
    $overrides['user'] = $options['user'];
}
if (is_string($options['group'] ?? null)) {
    $overrides['group'] = $options['group'];
}
if (isset($options['unprivileged'])) {
    $overrides['allowUnprivileged'] = true;
}

$config = $config->with($overrides);

switch ($command) {
    case 'serve':
        $journal = new Journal($config->logFile);
        exit((new Daemon($config, new Registry($config), $journal))->start());

    case 'ops':
        foreach ((new Registry($config))->names() as $name) {
            echo $name, "\n";
        }
        exit(0);

    case 'call':
        $op = $positional[0] ?? null;

        if ($op === null) {
            fwrite(STDERR, "Aufruf: cloudsrv-agentd call OP [JSON-ARGUMENTE]\n");
            exit(2);
        }

        $raw = $positional[1] ?? '{}';
        $args = json_decode($raw, true);

        if (!is_array($args)) {
            fwrite(STDERR, "Die Argumente sind kein gültiges JSON-Objekt.\n");
            exit(2);
        }

        try {
            $client = new Client($config->socket);
            $data = $client->call($op, $args, ['source' => 'cli', 'uid' => posix_getuid()], static function (array $frame): void {
                if (($frame['type'] ?? '') === 'progress') {
                    fwrite(STDERR, sprintf("… %3d %% %s\n", $frame['pct'] ?? 0, $frame['text'] ?? ''));
                }
                if (($frame['type'] ?? '') === 'log') {
                    fwrite(STDERR, ($frame['line'] ?? '') . "\n");
                }
            });

            echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
            exit(0);
        } catch (AgentException $error) {
            fwrite(STDERR, sprintf("%s: %s\n", $error->errorCode, $error->getMessage()));
            exit(1);
        }

    case 'version':
        echo Version::AGENT, ' (Protokoll ', Version::PROTOCOL, ")\n";
        exit(0);

    default:
        fwrite(STDERR, "Unbekannter Befehl {$command}. Bekannt: serve, call, ops, version.\n");
        exit(2);
}
