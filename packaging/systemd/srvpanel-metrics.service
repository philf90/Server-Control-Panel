[Unit]
Description=SrvPanel — Kennzahlen im Zehnsekundentakt
Documentation=https://repo.cloudsrv24.de/
After=srvpanel-agentd.service
Requires=srvpanel-agentd.service

# Gehört zu `srvpanel.target`: Ein `stop` oder `restart` des Ziels nimmt
# diese Unit mit. Ohne diese Zeile wäre das Ziel ein Griff, der nur
# anschaltet — und das ist ein halber Griff.
PartOf=srvpanel.target

[Service]
Type=simple
User=srvpanel
Group=srvpanel
WorkingDirectory=/opt/srvpanel/current
ExecStart=/opt/srvpanel/bin/php artisan srvpanel:metrics
Restart=always
RestartSec=5s

# Dieser Dienst liest /proc über den Agenten und schreibt Ringpuffer. Mehr
# braucht er nicht — und mehr bekommt er nicht.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/srvpanel /var/log/srvpanel

MemoryMax=192M
TasksMax=32

[Install]
WantedBy=multi-user.target
