[Unit]
Description=SrvPanel — PHP-FPM-Pool der Panel-Oberfläche
Documentation=https://repo.cloudsrv24.de/
After=network.target

# Gehört zu `srvpanel.target`: Ein `stop` oder `restart` des Ziels nimmt
# diese Unit mit. Ohne diese Zeile wäre das Ziel ein Griff, der nur
# anschaltet — und das ist ein halber Griff.
PartOf=srvpanel.target

[Service]
Type=notify
ExecStart=/opt/srvpanel/bin/php-fpm --nodaemonize --fpm-config /etc/srvpanel/fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2s

# Der Pool läuft als srvpanel und kommt ohne root aus. Alles Privilegierte
# geht über den Socket des Agenten — das ist die Trennlinie aus §4.1 des
# Plans, und sie steht hier in der Unit und nicht nur im Dokument.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# Der Schreibbereich der Anwendung liegt unter /var/lib/srvpanel/storage und
# ist damit von der ersten Angabe erfasst. Hier stand zusätzlich
# /opt/srvpanel/current/storage; das ist seit dem Umzug ein Verweis, und ein
# Verweis, dessen Ziel beim Start noch fehlt, lässt die Unit gar nicht erst
# hochkommen.
ReadWritePaths=/var/lib/srvpanel /var/log/srvpanel /run/srvpanel

MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
