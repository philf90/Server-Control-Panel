[Unit]
Description=SrvPanel — privilegierter Agent
Documentation=https://repo.cloudsrv24.de/
After=network.target
Before=srvpanel-worker.service srvpanel-metrics.service

[Service]
Type=simple
# `pcre.jit=0`, und zwar wegen MemoryDenyWriteExecute weiter unten.
#
# Der JIT von PCRE will Speicher, der beschreibbar und ausführbar zugleich
# ist — genau das, was die Härtung verbietet. PHP kommt damit zurecht und
# schaltet den JIT ab, schreibt dabei aber bei jedem Start eine Warnung ins
# Journal. Bei einem Prozess, der je Verbindung forkt, sind das vier Zeilen
# pro Aufruf des Panels.
#
# Die Alternative wäre, die Härtung zu lockern. Für einen Dienst, der als
# root Systembenutzer anlegt und Pakete installiert, ist der PCRE-JIT das
# schlechtere Tauschgut: Er beschleunigt reguläre Ausdrücke, die hier
# ausschließlich kurze Unit-Namen und Pfade prüfen.
ExecStart=/opt/srvpanel/bin/php -d pcre.jit=0 /opt/srvpanel/current/agent/bin/srvpanel-agentd serve --config=/etc/srvpanel/agent.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# Der Agent legt Systembenutzer an, lädt nginx neu und installiert Pakete. Er
# braucht root, und die Härtung kann deshalb nur begrenzen, was er sonst noch
# könnte — nicht, was seine Aufgabe ist.
#
# Was hier NICHT steht, ist so wichtig wie das, was steht:
#   ProtectSystem=  bleibt aus. Beim Vorgänger stand hier „true", also /usr
#                   read-only. Jede Paketinstallation brach daraufhin beim
#                   Auspacken ab, weil die Einschränkung für jeden Kindprozess
#                   gilt und dpkg einer ist. Gefunden hat das kein Test,
#                   sondern der erste Lauf auf einem echten Server.
#   ProtectHome=    bleibt aus. Die Abo-Verzeichnisse liegen unter
#                   /var/www/vhosts, der Dateimanager arbeitet dort.
#   NoNewPrivileges bleibt aus. useradd und apt rufen setuid-Programme auf.
ReadOnlyPaths=-/boot -/efi
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

RuntimeDirectory=srvpanel
RuntimeDirectoryMode=0755
LogsDirectory=srvpanel
StateDirectory=srvpanel

MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
